# Firebase Configuration
# Copy this file to .env and fill in your actual values
# Never commit the actual .env file to version control

# Firebase Web API Key
FIREBASE_WEB_API_KEY=your_web_api_key_here

# Firebase Android API Key  
FIREBASE_ANDROID_API_KEY=your_android_api_key_here

# Firebase iOS API Key
FIREBASE_IOS_API_KEY=your_ios_api_key_here

# Firebase Project Configuration
FIREBASE_PROJECT_ID=your_project_id_here
FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
FIREBASE_STORAGE_BUCKET=your_storage_bucket_here
FIREBASE_AUTH_DOMAIN=your_auth_domain_here

# iOS Specific
FIREBASE_IOS_CLIENT_ID=your_ios_client_id_here
FIREBASE_IOS_BUNDLE_ID=your_ios_bundle_id_here

# Google Maps API Key (if used)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
# Places Autocomplete / Geocoding HTTP (Dart). Must allow Places API + Geocoding
# API. Do NOT set iOS/Android application restrictions on this key (SDK key above
# can stay bundle-restricted). Without this, search returns REQUEST_DENIED.
GOOGLE_MAPS_WEB_API_KEY=your_google_maps_web_api_key_here

# Environment
APP_ENVIRONMENT=development
