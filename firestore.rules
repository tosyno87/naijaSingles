rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function canReadUserProfile(userId) {
      return request.auth != null &&
             (
               // Owner always reads own profile document.
               request.auth.uid == userId ||
               (
                // Non-owners can read active/public profiles.
                // Paused and incognito profiles are blocked here so that
                // privacy is enforced server-side, not just app-side.
                // The messages screen gracefully falls back to cached
                // thread data (userNames) when a profile read is denied.
                resource.data.isProfilePrivate != true &&
                resource.data.isDeleted != true &&
                resource.data.accountStatus != 'deleted' &&
                resource.data.accountStatus != 'banned' &&
                resource.data.accountStatus != 'paused' &&
                resource.data.accountStatus != 'incognito'
               )
             );
    }

    // Users collection - allow authenticated users to read others for matching
    match /users/{userId} {
      // Users can read and write their own data
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Authenticated users can read active/public profiles for matching/discovery.
      // Private or deleted/banned profiles are hidden from non-owners.
      allow read: if canReadUserProfile(userId);
      
      // Allow users to update their own profile with data validation
      allow update: if request.auth != null && 
                     request.auth.uid == userId &&
                     // Prevent users from changing critical fields
                     !request.resource.data.diff(resource.data).affectedKeys()
                       .hasAny(['createdAt', 'uid', 'email', 'signInMethod']);
      
      // Public profile subcollection (visible to others based on privacy settings)
      match /public/{document=**} {
        // Anyone can read public profile data
        allow read: if request.auth != null;
        // Only owner can write
        allow write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Private data subcollection (owner only)
      match /private/{document=**} {
        // Only owner can read/write private data
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // User subcollections - Enhanced permissions for likes/matches
      match /CheckedUser/{checkedUserId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      match /LikedBy/{likedById} {
        // Owner can read everyone who liked them.
        allow read: if request.auth != null &&
                    (request.auth.uid == userId || request.auth.uid == likedById);

        // Legacy like writer: liker writes to /users/{likedUser}/LikedBy/{likerId}.
        // Constrain writes so only the liker can write their own like record.
        allow create: if request.auth != null &&
                      request.auth.uid == likedById &&
                      request.resource.data.LikedBy == request.auth.uid;
        allow update, delete: if request.auth != null &&
                              request.auth.uid == likedById;
      }
      
      match /Matches/{matchId} {
        // Both matched users can read the match entry.
        allow read: if request.auth != null &&
                    (request.auth.uid == userId || request.auth.uid == matchId);
        // Legacy client writes either user's match mirror. Limit to matched pair only.
        allow create, update: if request.auth != null &&
                              (request.auth.uid == userId ||
                               request.auth.uid == matchId) &&
                              request.resource.data.Matches == matchId;
        allow delete: if request.auth != null &&
                      (request.auth.uid == userId ||
                       request.auth.uid == matchId);
      }
      
      match /blockedlist/{blockedId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // User notifications subcollection
      match /notifications/{notificationId} {
        // Only notification owner can access these documents from client SDK.
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Super Likes collection - for premium super like functionality
    match /superLikes/{superLikeId} {
      // Users can create super likes
      allow create: if request.auth != null && 
                     request.resource.data.fromUserId == request.auth.uid &&
                     request.resource.data.keys().hasAll(['fromUserId', 'toUserId', 'timestamp']);
      
      // Users can read super likes they sent
      allow read: if request.auth != null && 
                   request.auth.uid == resource.data.fromUserId;
      
      // Users can read super likes they received
      allow read: if request.auth != null && 
                   request.auth.uid == resource.data.toUserId;
      
      // Users can update super likes they received (for responding)
      allow update: if request.auth != null && 
                     request.auth.uid == resource.data.toUserId;
      
      // Users can update super likes they sent (for status changes)
      allow update: if request.auth != null && 
                     request.auth.uid == resource.data.fromUserId;
    }

    // Swipe History collection - for undo functionality
    match /swipeHistory/{swipeId} {
      // Users can create their own swipe history
      allow create: if request.auth != null && 
                     request.resource.data.userId == request.auth.uid &&
                     request.resource.data.keys().hasAll(['userId', 'targetUserId', 'direction', 'timestamp']);
      
      // Users can read their own swipe history
      allow read: if request.auth != null && 
                   request.auth.uid == resource.data.userId;
      
      // Users can update their own swipe history (for undo operations)
      allow update: if request.auth != null && 
                     request.auth.uid == resource.data.userId;
    }

    // Super Like Usage collection - for tracking daily limits
    match /superLikeUsage/{usageId} {
      // Users can only create their own usage records.
      allow create: if request.auth != null &&
                     request.resource.data.userId == request.auth.uid;
      
      // Users can read their own usage records
      allow read: if request.auth != null && 
                   request.auth.uid == resource.data.userId;
    }

    // Undo Usage collection - for tracking undo limits
    match /undoUsage/{usageId} {
      // Users can only create their own usage records.
      allow create: if request.auth != null &&
                     request.resource.data.userId == request.auth.uid;
      
      // Users can read their own usage records
      allow read: if request.auth != null && 
                   request.auth.uid == resource.data.userId;
    }

    // Likes collection - for the new likes service (Enhanced permissions)
    match /likes/{likeId} {
      // Only the liker can create a like, and it must reference themselves.
      allow create: if request.auth != null && 
                     request.resource.data.from == request.auth.uid &&
                     request.resource.data.keys().hasAll(['from', 'to', 'timestamp']);

      // Allow direct get lookups when current user is part of deterministic likeId
      // format: {from}_likes_{to}
      allow get: if request.auth != null &&
                 (likeId.matches('^' + request.auth.uid + '_likes_.+$') ||
                  likeId.matches('^.+_likes_' + request.auth.uid + '$') ||
                  (request.auth.uid == resource.data.from ||
                   request.auth.uid == resource.data.to));

      // List/query reads remain scoped to likes involving current user
      allow list: if request.auth != null &&
                  (request.auth.uid == resource.data.from ||
                   request.auth.uid == resource.data.to);
      
      // Users can update likes where they are involved (for mutual likes).
      // Core identity fields (from, to) are immutable after creation.
      allow update: if request.auth != null && 
                     (request.auth.uid == resource.data.from || 
                      request.auth.uid == resource.data.to) &&
                     !request.resource.data.diff(resource.data).affectedKeys()
                       .hasAny(['from', 'to']);
      
      // Users can delete their own likes
      allow delete: if request.auth != null && 
                     request.auth.uid == resource.data.from;
    }

    // Legacy likes collection - fully disabled.
    // No app or Cloud Function code references this collection.
    // All like operations use the lowercase /likes collection.
    match /Likes/{likeId} {
      allow read, write: if false;
    }

    // Matches collection - for storing user matches (Enhanced permissions)
    match /matches/{matchId} {
      // Users can read matches they're part of
      allow read: if request.auth != null && 
                   request.auth.uid in resource.data.users;
      
      // Only a participant can create a match, must include themselves.
      // NOTE: This still allows unilateral creation (user A creates a match
      // with user B without mutual consent at the rules level). Mutual-like
      // verification happens in LikesService._createMatchOptimized() which
      // checks the reverse like before batch-writing the match. Long-term,
      // move match creation to a Cloud Function (Admin SDK) to enforce
      // mutual consent server-side.
      allow create: if request.auth != null && 
                     request.auth.uid in request.resource.data.users &&
                     request.resource.data.keys().hasAll(['users', 'matchedAt']) &&
                     request.resource.data.users.size() == 2;
      
      // Users can update matches they're part of
      allow update: if request.auth != null && 
                     request.auth.uid in resource.data.users;
      
      // Users can delete matches they're part of (unmatch)
      allow delete: if request.auth != null && 
                     request.auth.uid in resource.data.users;
    }

    // Legacy matches collection (Enhanced for backward compatibility)
    match /Matches/{matchId} {
      // Users can read matches they're part of
      allow read: if request.auth != null && 
                   request.auth.uid in resource.data.users;
      
      // Users can create matches
      allow create: if request.auth != null && 
                     request.auth.uid in request.resource.data.users;
      
      // Users can update matches they're part of
      allow update: if request.auth != null && 
                     request.auth.uid in resource.data.users;
      
      // Users can delete matches they're part of (for unmatching)
      allow delete: if request.auth != null && 
                     request.auth.uid in resource.data.users;
    }

    // Chat threads collection - ENHANCED WITH PRACTICAL SECURITY
    match /chatThreads/{threadId} {
      // Users can read chat threads they're part of
      // Simplified to avoid complex rule evaluation issues
      allow read: if request.auth != null &&
                   request.auth.uid in resource.data.userIds;
      
      // Users can create chat threads - match verification handled at app level
      // This prevents blocking legitimate matches due to Firestore query limitations
      allow create: if request.auth != null &&
                     request.auth.uid in request.resource.data.userIds &&
                     request.resource.data.userIds.size() == 2 &&
                     // Basic validation - ensure it's a proper chat thread structure
                     request.resource.data.keys().hasAll(['userIds', 'createdAt']);
      
      // Users can update chat threads they're part of (for last message, unread count)
      allow update: if request.auth != null &&
                     request.auth.uid in resource.data.userIds &&
                     // Prevent changing userIds after creation
                     !request.resource.data.diff(resource.data).affectedKeys().hasAny(['userIds']);
      
      // Users can delete chat threads they're part of
      allow delete: if request.auth != null &&
                     request.auth.uid in resource.data.userIds;
    }

    // Messages subcollection within chat threads - ENHANCED SECURITY
    match /chatThreads/{threadId}/messages/{messageId} {
      // Users can read messages in threads they're part of
      allow read: if request.auth != null && 
                   exists(/databases/$(database)/documents/chatThreads/$(threadId)) &&
                   request.auth.uid in get(/databases/$(database)/documents/chatThreads/$(threadId)).data.userIds;
      
      // Users can create messages in threads they're part of with validation
      allow create: if request.auth != null && 
                     exists(/databases/$(database)/documents/chatThreads/$(threadId)) &&
                     request.auth.uid in get(/databases/$(database)/documents/chatThreads/$(threadId)).data.userIds &&
                     request.resource.data.senderId == request.auth.uid &&
                     // Message validation
                     request.resource.data.keys().hasAll(['senderId', 'text', 'timestamp']) &&
                     request.resource.data.text is string &&
                     request.resource.data.text.size() > 0 &&
                     request.resource.data.text.size() <= 1000; // Max message length
      
      // Users can update messages for read status only
      allow update: if request.auth != null && 
                     exists(/databases/$(database)/documents/chatThreads/$(threadId)) &&
                     request.auth.uid in get(/databases/$(database)/documents/chatThreads/$(threadId)).data.userIds &&
                     // Only allow updating read status, not content
                     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      
      // Users can delete their own messages only
      allow delete: if request.auth != null && 
                     exists(/databases/$(database)/documents/chatThreads/$(threadId)) &&
                     request.auth.uid in get(/databases/$(database)/documents/chatThreads/$(threadId)).data.userIds &&
                     resource.data.senderId == request.auth.uid;
    }

    // Typing indicators subcollection (for future real-time typing)
    match /chatThreads/{threadId}/typing/{userId} {
      // Users can read typing status in threads they're part of
      allow read: if request.auth != null && 
                   exists(/databases/$(database)/documents/chatThreads/$(threadId)) &&
                   request.auth.uid in get(/databases/$(database)/documents/chatThreads/$(threadId)).data.userIds;
      
      // Users can only update their own typing status
      allow write: if request.auth != null && 
                    exists(/databases/$(database)/documents/chatThreads/$(threadId)) &&
                    request.auth.uid in get(/databases/$(database)/documents/chatThreads/$(threadId)).data.userIds &&
                    request.auth.uid == userId;
    }

    // Chats collection (legacy support)
    match /chats/{chatId} {
      allow read, write: if request.auth != null && 
                          request.auth.uid in resource.data.users;
      allow create: if request.auth != null && 
                     request.auth.uid in request.resource.data.users;
    }

    // Reports collection - for user reports with validation
    match /reports/{reportId} {
      allow create: if request.auth != null && 
                     request.auth.uid == request.resource.data.reporterId &&
                     request.resource.data.keys().hasAll(['reporterId', 'reportedUserId', 'reason', 'timestamp']) &&
                     request.resource.data.reason is string &&
                     request.resource.data.reason.size() > 0;
      allow read: if request.auth != null && 
                   request.auth.uid == resource.data.reporterId;
    }

    // Notifications collection with better validation
    match /notifications/{notificationId} {
      allow read: if request.auth != null && 
                   request.auth.uid == resource.data.userId;
      allow update, delete: if request.auth != null && 
                            request.auth.uid == resource.data.userId;
      // Client-side create limited to self-owned notifications.
      allow create: if request.auth != null &&
                    request.auth.uid == request.resource.data.userId;
    }

    // Notification Logs collection - for analytics (admin only)
    match /notificationLogs/{logId} {
      // Block client SDK writes. Use Admin SDK (Cloud Functions) for logs.
      allow create: if false;
      // Users can read their own notification logs
      allow read: if request.auth != null && 
                   request.auth.uid == resource.data.userId;
    }

    // Notification Settings collection
    match /notificationSettings/{userId} {
      allow read, write: if request.auth != null && 
                          request.auth.uid == userId;
    }

    // Feedback collection - users can only create their own feedback
    match /feedback/{feedbackId} {
      allow create: if request.auth != null && 
                     request.auth.uid == request.resource.data.userId;
      allow read: if request.auth != null && 
                   request.auth.uid == resource.data.userId;
    }

    // User settings/preferences
    match /userSettings/{userId} {
      allow read, write: if request.auth != null && 
                          request.auth.uid == userId;
    }

    // Events collection - for user-generated events
    match /events/{eventId} {
      // Anyone can read published events (needed for queries and filters)
      allow read: if request.auth != null;
      
      // Users can create events
      allow create: if request.auth != null && 
                     request.auth.uid == request.resource.data.createdByUserId &&
                     request.resource.data.keys().hasAll(['name', 'description', 'startDate', 'endDate', 'createdByUserId', 'status']) &&
                     request.resource.data.name is string &&
                     request.resource.data.name.size() > 0 &&
                     request.resource.data.description is string;
      
      // Users can update their own events
      allow update: if request.auth != null && 
                     request.auth.uid == resource.data.createdByUserId &&
                     // Prevent changing the creator
                     !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdByUserId']);
      
      // Users can delete their own events
      allow delete: if request.auth != null && 
                     request.auth.uid == resource.data.createdByUserId;
    }

    // Event RSVPs collection - for tracking event attendance
    match /eventRSVPs/{rsvpId} {
      // Users can read RSVPs for events they created
      allow read: if request.auth != null && 
                   exists(/databases/$(database)/documents/events/$(resource.data.eventId)) &&
                   request.auth.uid == get(/databases/$(database)/documents/events/$(resource.data.eventId)).data.createdByUserId;
      
      // Users can read their own RSVPs
      allow read: if request.auth != null && 
                   request.auth.uid == resource.data.userId;
      
      // Users can create RSVPs for published events
      allow create: if request.auth != null && 
                     request.auth.uid == request.resource.data.userId &&
                     exists(/databases/$(database)/documents/events/$(request.resource.data.eventId)) &&
                     get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.status == 'published' &&
                     request.resource.data.keys().hasAll(['userId', 'eventId', 'status', 'timestamp']);
      
      // Users can update their own RSVPs
      allow update: if request.auth != null && 
                     request.auth.uid == resource.data.userId &&
                     // Prevent changing userId or eventId
                     !request.resource.data.diff(resource.data).affectedKeys().hasAny(['userId', 'eventId']);
      
      // Users can delete their own RSVPs
      allow delete: if request.auth != null && 
                     request.auth.uid == resource.data.userId;
    }

    // User Events collection - for user's event management
    match /userEvents/{userId} {
      // Users can only access their own events
      allow read, write: if request.auth != null && 
                          request.auth.uid == userId;
      
      // Events subcollection within user events
      match /events/{eventId} {
        allow read, write: if request.auth != null && 
                            request.auth.uid == userId;
      }
    }

    // User RSVPs collection - for tracking user's event RSVPs
    match /user_rsvps/{userId} {
      // Users can only access their own RSVPs
      allow read, write: if request.auth != null && 
                          request.auth.uid == userId;
      
      // Events subcollection within user RSVPs
      match /events/{eventId} {
        allow read, write: if request.auth != null && 
                            request.auth.uid == userId;
      }
    }

    // Event Attendees collection - for tracking event attendance
    match /event_attendees/{eventId} {
      // Event creators can read attendees of their events
      allow read: if request.auth != null && 
                   exists(/databases/$(database)/documents/events/$(eventId)) &&
                   request.auth.uid == get(/databases/$(database)/documents/events/$(eventId)).data.createdByUserId;
      
      // Attendees subcollection
      match /attendees/{userId} {
        // Users can read/write their own attendance
        allow read, write: if request.auth != null && 
                            request.auth.uid == userId;
        
        // Event creators can read attendees
        allow read: if request.auth != null && 
                     exists(/databases/$(database)/documents/events/$(eventId)) &&
                     request.auth.uid == get(/databases/$(database)/documents/events/$(eventId)).data.createdByUserId;
      }
    }

    // Event Moderation collection - for event approval workflow
    match /event_moderation/{eventId} {
      // Users can read moderation status of their own events
      allow read: if request.auth != null && 
                   exists(/databases/$(database)/documents/events/$(eventId)) &&
                   request.auth.uid == get(/databases/$(database)/documents/events/$(eventId)).data.createdByUserId;
      
      // Client-side writes blocked. Use Admin SDK (Cloud Functions) for moderation.
      allow create, update: if false;
    }

    // Unified Groups collection - for the new unified group system
    match /unifiedGroups/{groupId} {
      // Users can read groups
      allow read: if request.auth != null;
      
      // Users can create groups
      allow create: if request.auth != null && 
                     request.auth.uid == request.resource.data.creatorId;
      
      // Group updates - simplified and robust
      allow update: if request.auth != null && 
                     (request.auth.uid in resource.data.adminIds ||
                      // Join group
                      (request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1 &&
                       request.auth.uid in request.resource.data.memberIds) ||
                      // Leave group
                      (request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1 &&
                       !(request.auth.uid in request.resource.data.memberIds)));
      
      // Group creators can delete groups
      allow delete: if request.auth != null && 
                     request.auth.uid == resource.data.creatorId;
      
      // Messages subcollection within unified groups
      match /messages/{messageId} {
        // Group members can read messages
        allow read: if request.auth != null && 
                     exists(/databases/$(database)/documents/unifiedGroups/$(groupId)) &&
                     request.auth.uid in get(/databases/$(database)/documents/unifiedGroups/$(groupId)).data.memberIds;
        
        // Group members can create messages
        allow create: if request.auth != null && 
                       exists(/databases/$(database)/documents/unifiedGroups/$(groupId)) &&
                       request.auth.uid in get(/databases/$(database)/documents/unifiedGroups/$(groupId)).data.memberIds &&
                       request.resource.data.senderId == request.auth.uid;
        
        // Group members can update messages for read status
        allow update: if request.auth != null && 
                       exists(/databases/$(database)/documents/unifiedGroups/$(groupId)) &&
                       request.auth.uid in get(/databases/$(database)/documents/unifiedGroups/$(groupId)).data.memberIds &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readBy']);
        
        // Group members can delete their own messages
        allow delete: if request.auth != null && 
                       exists(/databases/$(database)/documents/unifiedGroups/$(groupId)) &&
                       request.auth.uid in get(/databases/$(database)/documents/unifiedGroups/$(groupId)).data.memberIds &&
                       resource.data.senderId == request.auth.uid;
      }
    }

    // Legacy Groups collection - for backward compatibility
    match /groups/{groupId} {
      // Users can read public groups
      allow read: if request.auth != null && 
                   resource.data.isPublic == true;
      
      // Users can read groups they're members of
      allow read: if request.auth != null && 
                   request.auth.uid in resource.data.memberIds;
      
      // Users can read group details for any group (needed for join validation)
      allow read: if request.auth != null;
      
      // Users can create groups
      allow create: if request.auth != null && 
                     request.auth.uid == request.resource.data.creatorId;
      
      // Group creators and admins can update groups
      // Users can update memberIds to join/leave groups
      // Allow member cleanup operations
      allow update: if request.auth != null && 
                     (request.auth.uid in resource.data.adminIds ||
                      // Allow users to join/leave groups by updating memberIds
                      (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'memberCount', 'lastActivityAt', 'updatedAt']) &&
                       request.auth.uid in request.resource.data.memberIds) ||
                      // Allow member cleanup operations (removing duplicates)
                      (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'memberCount', 'updatedAt']) &&
                       request.resource.data.memberIds.size() <= resource.data.memberIds.size()));
      
      // Group creators can delete groups
      allow delete: if request.auth != null && 
                     request.auth.uid == resource.data.creatorId;
    }

    // Group Chats collection - for the original group chat system
    match /groupChats/{groupId} {
      // Users can read groups they're members of
      allow read: if request.auth != null && 
                   request.auth.uid in resource.data.memberIds;
      
      // Users can read group details for any group (needed for join validation)
      allow read: if request.auth != null;
      
      // Users can create groups
      allow create: if request.auth != null && 
                     request.auth.uid == request.resource.data.creatorId;
      
      // Group creators and admins can update groups
      // Users can update memberIds to join/leave groups
      // Allow member cleanup operations
      allow update: if request.auth != null && 
                     (request.auth.uid in resource.data.adminIds ||
                      // Allow users to join/leave groups by updating memberIds
                      (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'memberCount', 'lastActivityAt', 'updatedAt']) &&
                       request.auth.uid in request.resource.data.memberIds) ||
                      // Allow member cleanup operations (removing duplicates)
                      (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'memberCount', 'updatedAt']) &&
                       request.resource.data.memberIds.size() <= resource.data.memberIds.size()));
      
      // Group creators can delete groups
      allow delete: if request.auth != null && 
                     request.auth.uid == resource.data.creatorId;
      
      // Messages subcollection within group chats
      match /messages/{messageId} {
        // Group members can read messages
        allow read: if request.auth != null && 
                     exists(/databases/$(database)/documents/groupChats/$(groupId)) &&
                     request.auth.uid in get(/databases/$(database)/documents/groupChats/$(groupId)).data.memberIds;
        
        // Group members can create messages
        allow create: if request.auth != null && 
                       exists(/databases/$(database)/documents/groupChats/$(groupId)) &&
                       request.auth.uid in get(/databases/$(database)/documents/groupChats/$(groupId)).data.memberIds &&
                       request.resource.data.senderId == request.auth.uid;
        
        // Group members can update messages for read status
        allow update: if request.auth != null && 
                       exists(/databases/$(database)/documents/groupChats/$(groupId)) &&
                       request.auth.uid in get(/databases/$(database)/documents/groupChats/$(groupId)).data.memberIds;
        
        // Group members can delete their own messages
        allow delete: if request.auth != null && 
                       exists(/databases/$(database)/documents/groupChats/$(groupId)) &&
                       request.auth.uid in get(/databases/$(database)/documents/groupChats/$(groupId)).data.memberIds &&
                       resource.data.senderId == request.auth.uid;
      }
    }

    // Item access collection (for app configuration)
    match /Item_access/{itemId} {
      allow read: if request.auth != null;
    }

    // Group Invitations collection - for managing group invitations
    match /groupInvitations/{invitationId} {
      // Users can read invitations sent to them
      allow read: if request.auth != null && 
                   request.auth.uid == resource.data.invitedUserId;
      
      // Users can read invitations they sent
      allow read: if request.auth != null && 
                   request.auth.uid == resource.data.invitedByUserId;
      
      // Group creators and admins can create invitations
      allow create: if request.auth != null && 
                     request.auth.uid == request.resource.data.invitedByUserId &&
                     request.resource.data.keys().hasAll(['groupId', 'invitedUserId', 'invitedByUserId', 'status', 'createdAt']) &&
                     request.resource.data.status == 'pending';
      
      // Invited users can update invitation status
      allow update: if request.auth != null && 
                     request.auth.uid == resource.data.invitedUserId &&
                     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt', 'declinedAt']) &&
                     resource.data.status == 'pending';
      
      // Group creators and admins can delete invitations
      allow delete: if request.auth != null && 
                     request.auth.uid == resource.data.invitedByUserId;
    }

    // User Group Notifications collection - for group mute/unmute preferences
    match /user_group_notifications/{notificationId} {
      // Users can read and write their own group notification preferences
      allow read, write: if request.auth != null && 
                          request.auth.uid == resource.data.userId;
      
      // Users can create their own notification preferences
      allow create: if request.auth != null && 
                     request.auth.uid == request.resource.data.userId &&
                     request.resource.data.keys().hasAll(['userId', 'groupId', 'isMuted', 'updatedAt']);
    }

    // Group Unread Counts collection - for tracking unread messages per group
    match /group_unread_counts/{countId} {
      // Users can read and write their own unread counts
      allow read, write: if request.auth != null && 
                          request.auth.uid == resource.data.userId;
      
      // Users can create their own unread count records
      allow create: if request.auth != null && 
                     request.auth.uid == request.resource.data.userId &&
                     request.resource.data.keys().hasAll(['userId', 'groupId', 'count', 'updatedAt']);
      
      // System can update unread counts (for message sending)
      allow update: if request.auth != null;
    }

    // Group Reports collection - for group abuse reports
    match /group_reports/{reportId} {
      // Users can create reports
      allow create: if request.auth != null && 
                     request.auth.uid == request.resource.data.reporterId &&
                     request.resource.data.keys().hasAll(['groupId', 'reporterId', 'reason', 'status', 'createdAt']) &&
                     request.resource.data.status == 'pending';
      
      // Users can read their own reports
      allow read: if request.auth != null && 
                   request.auth.uid == resource.data.reporterId;
      
      // Group creators and admins can read reports for their groups
      allow read: if request.auth != null && 
                   exists(/databases/$(database)/documents/unifiedGroups/$(resource.data.groupId)) &&
                   (request.auth.uid == get(/databases/$(database)/documents/unifiedGroups/$(resource.data.groupId)).data.creatorId ||
                    request.auth.uid in get(/databases/$(database)/documents/unifiedGroups/$(resource.data.groupId)).data.adminIds);
    }

    // Security Logs collection - for monitoring and analytics
    match /security_logs/{logId} {
      // Client-side writes blocked. Use Admin SDK (Cloud Functions) for logs.
      allow create: if false;
      
      // Users can read logs related to their reports
      allow read: if request.auth != null && 
                   request.auth.uid == resource.data.reporterId;
    }

    // Account Deletions collection - for audit logging
    match /accountDeletions/{deletionId} {
      // Users can create their own deletion records
      allow create: if request.auth != null && 
                     request.auth.uid == request.resource.data.userId;
      
      // Users can read their own deletion records
      allow read: if request.auth != null && 
                   request.auth.uid == resource.data.userId;
    }

    // Block any other access not explicitly allowed above
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
