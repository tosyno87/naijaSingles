rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only access their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Secure match creation and access
    match /matches/{matchId} {
      allow read, write: if request.auth.uid in resource.data.users;
      allow create: if request.auth.uid in request.resource.data.users;
    }

    // Chat threads
    match /chatThreads/{threadId} {
      allow read: if request.auth != null &&
                   request.auth.uid in resource.data.userIds;
      allow create: if request.auth != null &&
                     request.auth.uid in request.resource.data.userIds;
      allow update: if request.auth != null &&
                     request.auth.uid in resource.data.userIds;
    }

    // Messages inside chatThreads
    match /chatThreads/{threadId}/messages/{messageId} {
      allow read: if request.auth != null && 
                   exists(/databases/$(database)/documents/chatThreads/$(threadId)) &&
                   request.auth.uid in get(/databases/$(database)/documents/chatThreads/$(threadId)).data.userIds;
      allow create: if request.auth != null && 
                     exists(/databases/$(database)/documents/chatThreads/$(threadId)) &&
                     request.auth.uid in get(/databases/$(database)/documents/chatThreads/$(threadId)).data.userIds &&
                     request.resource.data.senderId == request.auth.uid;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
