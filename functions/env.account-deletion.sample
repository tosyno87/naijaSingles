# Copy values into Firebase Functions config / Cloud Console secrets (do not commit real secrets).
# DELETION_OTP_PEPPER: long random string (required for OTP callables in production)
# SENDGRID_API_KEY + SENDGRID_FROM_EMAIL: email OTP delivery
# Twilio is not used for account deletion (phone path = Firebase PhoneAuth + confirmDeletionAfterPhoneProof).
# ACCOUNT_DELETION_ENFORCE_APPCHECK (optional; default if unset: true)
#   true  = enforce App Check on startDeletionOtp, confirmDeletionOtp,
#           confirmDeletionAfterPhoneProof (use in production once App Check is stable).
#   false = do not enforce App Check on those callables (non-prod / staging unblock).
# Set via Cloud Functions runtime env for each project (Console → Functions → your function
# → Environment variables), or .env loaded by your deploy pipeline — not committed.

DELETION_OTP_PEPPER=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
ACCOUNT_DELETION_ENFORCE_APPCHECK=true
# Staging example:
# ACCOUNT_DELETION_ENFORCE_APPCHECK=false
