rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow authenticated users to manage their own profile photos and view others' photos
    match /profile_photos/{userId}/{allPaths=**} {
      // Allow users to read and write their own photos
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // Allow any authenticated user to read photos
      allow read: if request.auth != null;
    }
    
    // For users directory structure
    match /users/{userId}/{allPaths=**} {
      // Allow users to read and write their own photos
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // Allow any authenticated user to read photos
      allow read: if request.auth != null;
    }
    
    // Event images - allow authenticated users to upload and read
    match /event_images/{allPaths=**} {
      // Allow authenticated users to upload event images
      allow write: if request.auth != null;
      
      // Allow any authenticated user to read event images
      allow read: if request.auth != null;
    }
    
    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
