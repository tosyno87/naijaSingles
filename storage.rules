rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isImageUpload() {
      return request.resource != null &&
             request.resource.contentType.matches('image/.*');
    }

    function isReasonableImageSize() {
      // 10 MB max per image upload.
      return request.resource != null && request.resource.size < 10 * 1024 * 1024;
    }

    // Allow authenticated users to manage their own profile photos and view others' photos
    match /profile_photos/{userId}/{allPaths=**} {
      // Allow users to read and write their own photos
      allow write: if isSignedIn() &&
                   request.auth.uid == userId &&
                   isImageUpload() &&
                   isReasonableImageSize();
      
      // Allow any authenticated user to read photos
      allow read: if isSignedIn();
    }
    
    // For users directory structure
    match /users/{userId}/{allPaths=**} {
      // Allow users to read and write their own photos
      allow write: if isSignedIn() &&
                   request.auth.uid == userId &&
                   isImageUpload() &&
                   isReasonableImageSize();
      
      // Allow any authenticated user to read photos
      allow read: if isSignedIn();
    }
    
    // Event images (owner-scoped path): event_images/{ownerId}/{...}
    match /event_images/{ownerId}/{allPaths=**} {
      // Only the owner can upload/update/delete under their event image path.
      allow write: if isSignedIn() &&
                   request.auth.uid == ownerId &&
                   isImageUpload() &&
                   isReasonableImageSize();

      // Any authenticated user can read published event media.
      allow read: if isSignedIn();
    }

    // Group avatars (owner-scoped path): group_avatars/{ownerId}/{...}
    match /group_avatars/{ownerId}/{allPaths=**} {
      // Only the owner can upload/update/delete under their group avatar path.
      allow write: if isSignedIn() &&
                   request.auth.uid == ownerId &&
                   isImageUpload() &&
                   isReasonableImageSize();

      // Any authenticated user can read group avatars.
      allow read: if isSignedIn();
    }

    // Legacy group avatar paths (without owner prefix) remain read-only.
    match /group_avatars/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Legacy event image paths (without owner prefix) remain read-only.
    match /event_images/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if false;
    }
    
    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
